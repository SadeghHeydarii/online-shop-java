@startuml
skinparam shadowing false

component "Online Shop" as app {
  component "org.example.Main" as Main
  component "org.example.cli\norg.example.cli.menu" as cli
  component "org.example.service" as services
  component "org.example.service.port" as ports
  component "org.example.infrastructure.persistence" as persistence
  component "org.example.infrastructure.security" as security
  component "org.example.model.entity\norg.example.model.vo\norg.example.model.enums" as model
  component "org.example.exception" as exceptions
  component "org.example.util.DataSeeder" as DataSeeder
  component "org.example.util.PasswordUtil" as PasswordUtil
}

Main ..> cli : starts menus
Main ..> services : constructs
Main ..> model : types the maps
Main ..> DataSeeder : seeds maps
DataSeeder ..> services : adds products
DataSeeder ..> model : creates seed data
DataSeeder ..> PasswordUtil : hashes passwords
cli ..> services : calls
cli ..> model : reads and constructs values
cli ..> exceptions : handles
services ..> model : manages
services ..> exceptions : throws
services ..> PasswordUtil : hashes and verifies
persistence ..> ports : implements repository interfaces
persistence ..> model : stores domain objects
security ..> ports : implements security interfaces
security ..> PasswordUtil : Sha256PasswordHasher delegates
ports ..> model : uses domain types
@enduml
